# ==============================================================================
# Variables de Entorno de Configuración - MiBici MLOps Multi-Servicio
# Orquestación con Docker Compose
# ==============================================================================

# Puerto de exposición del microservicio FastAPI (host:container)
PORT=8000

# Puerto de exposición del servidor de tracking de MLflow (host:container)
MLFLOW_PORT=5000

# URI interna de conexión hacia el servidor MLflow a través de la red bridge mibici-net
MLFLOW_TRACKING_URI=http://mlflow:5000

# Alias del modelo registrado a servir en producción (champion / challenger)
MODEL_ALIAS=champion

# Nivel de registro de logs del servidor ASGI y FastAPI (debug / info / warning / error)
LOG_LEVEL=info

# Límites de recursos asignados al microservicio de inferencia
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1G

# Límites de recursos asignados al servidor de MLflow
MLFLOW_CPU_LIMIT=1.0
MLFLOW_MEMORY_LIMIT=1G
